# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Security — MUST be a strong random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Environment
NODE_ENV=production
PORT=4000

# CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://diocesan-finance-api.vercel.app
